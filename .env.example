# =========================================
# AppForge Environment Configuration
# =========================================
# Copy this file to .env.local and fill in your actual values
# Never commit .env.local to version control!

# =========================================
# Base44 Configuration (REQUIRED)
# =========================================
# Your Base44 API credentials from https://appforge.fun
# Frontend Configuration
VITE_BASE44_USERNAME=your_username_here
VITE_BASE44_PASSWORD=your_password_here
VITE_BASE44_API_URL=https://appforge.fun
# Optional service token for admin-only operations (Base44)
VITE_BASE44_SERVICE_TOKEN=

# Backend Configuration (for server-side Base44 integration)
BASE44_USERNAME=your_username_here
BASE44_PASSWORD=your_password_here
BASE44_API_URL=https://appforge.fun
BASE44_APP_ID=your_app_id
BASE44_SERVICE_TOKEN=your_service_token

# Demo / optional integrations (set to true to enable demo flows)
VITE_DEMO_MODE=false
VITE_WEB3_ENABLED=false
VITE_GITHUB_INTEGRATION=false
VITE_EMAIL_INTEGRATION=false
VITE_VSCODE_INTEGRATION=false
VITE_ANALYTICS_ENABLED=false
VITE_COLLABORATION_ENABLED=false
VITE_SECURITY_ENABLED=false
VITE_AI_ROUTER_ENABLED=false
VITE_LLM_SETTINGS_ENABLED=false

# Solana (Phantom) payments
SOLANA_ADMIN_WALLET=
SOLANA_NETWORK=mainnet-beta
SOLANA_RPC_URL=

# =========================================
# 🐝 SWARM REALITY TRADING (SOLANA/JUPITER)
# =========================================
# Hard reality mode (disables simulation fallbacks in swarm runtime)
SWARM_REALITY_MODE=true

# Wallet used by Jupiter integration for real quotes/swaps
SOLANA_WALLET_ADDRESS=
SOLANA_PRIVATE_KEY=

# Live execution gates
REAL_TRADING_ENABLED=false
SWARM_AUTO_EXECUTE_TRADES=true

# Risk guardrails for any single SOL-denominated trade
SWARM_MAX_TRADE_SOL=0.2

# Autonomous trading challenge
SWARM_AUTONOMOUS_TRADING_ENABLED=true
SWARM_AUTOTRADE_TRIGGER_SOL=0.2
SWARM_AUTOTRADE_TARGET_SOL=50
SWARM_AUTOTRADE_DURATION_HOURS=72
SWARM_AUTOTRADE_INTERVAL_MS=300000
SWARM_AUTOTRADE_POLL_INTERVAL_MS=15000
SWARM_AUTOTRADE_MIN_SOL_RESERVE=0.02
SWARM_AUTOTRADE_RISK_PER_TRADE=0.10
SWARM_AUTOTRADE_MAX_DRAWDOWN_PCT=35
SWARM_AUTOTRADE_MAX_TRADES_PER_DAY=18
SWARM_AUTOTRADE_MIN_SIGNAL_PCT=0.002
SWARM_AUTOTRADE_SLIPPAGE_PCT=1
SWARM_AUTOTRADE_MAX_CONSECUTIVE_FAILURES=4

# Mobile build pipeline (optional)
MOBILE_BUILD_WEBHOOK_URL=

# Bot pipeline (optional)
BOT_BUILD_WEBHOOK_URL=
BOT_DEPLOY_BASE_URL=

# =========================================
# Application Settings
# =========================================
# Application environment: development, staging, production
VITE_APP_ENV=development

# Application name and URL
VITE_APP_NAME=AppForge
VITE_APP_URL=http://localhost:5173

# Enable/disable features
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_ERROR_TRACKING=false

# ===========================
# 🔐 XENDIT PAYMENT CONFIGURATION
# ===========================
# Get keys from: https://dashboard.xendit.co/settings/developers/api-keys

# Secret API Key (for backend authentication)
# Format: xnd_development_xxx (development) or xnd_production_xxx (production)
# SECURITY: Never log or expose this key
XENDIT_SECRET_KEY=your_xendit_secret_key_here

# Public API Key (for frontend/client-side usage)
XENDIT_PUBLIC_KEY=your_xendit_public_key_here

# Webhook Key (for webhook signature verification)
# Critical for security - used to verify webhooks come from Xendit
XENDIT_WEBHOOK_KEY=xnd_webhook_secret_key_here

# API Configuration
XENDIT_API_VERSION=2020-02-14
XENDIT_API_BASE=https://api.xendit.co/v4

# Test mode (use sandbox credentials if true)
XENDIT_TEST_MODE=false

# ===========================
# 🤖 AI MODEL ROUTER CONFIGURATION
# ===========================
# Intelligent routing between multiple AI providers
# The AI Router automatically selects the best model for each prompt
# All keys are optional - Base44 is always available as fallback

# OpenAI (ChatGPT, GPT-4, DALL-E, Embeddings)
# Get key from: https://platform.openai.com/api-keys
# Best for: Code generation, implementation, debugging, semantic search
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxx

# OpenAI Embeddings Configuration
OPENAI_EMBEDDING_MODEL=text-embedding-3-small  # or text-embedding-3-large
ENABLE_EMBEDDING_CACHE=true  # Cache embeddings to reduce API costs
EMBEDDING_CACHE_TTL=86400  # Cache duration in seconds (24 hours default)

# Anthropic (Claude 3 Opus/Sonnet)
# Get key from: https://console.anthropic.com/account/keys
# Best for: Deep reasoning, analysis, long-form content
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# Google (Gemini)
# Get key from: https://ai.google.dev/
# Best for: Vision/image tasks, multimodal analysis
GEMINI_API_KEY=AIzaSyDxxxxxxxxxxxxxxxxxxxxxxxx

# X.AI (Grok)
# Get key from: https://console.x.ai/
# Best for: Creative tasks, experimental queries
GROK_API_KEY=xai-xxxxxxxxxxxxxxxxxxxxxxxx

# AI Router Configuration
AI_ROUTER_ENABLED=true
AI_ROUTER_AUTO_ROUTE=true
AI_ROUTER_FALLBACK_TO_BASE44=true
AI_ROUTER_RETRY_ON_FAILURE=true

# ===========================
# 🗄️ DATABASE CONFIGURATION
# ===========================

# PostgreSQL Primary Database
# Full PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/appforge

# Or specify components separately
DB_HOST=localhost
DB_PORT=5432
DB_NAME=appforge
DB_USER=appforge_user
DB_PASSWORD=secure_password_here

# PostgreSQL Read Replicas (OPTIONAL)
# Enable read replicas for production environments to distribute read traffic
# Format: host:port for the read replica endpoint
POSTGRES_READ_REPLICA_HOST=localhost
POSTGRES_READ_REPLICA_PORT=5433
POSTGRES_READ_REPLICA_USER=appforge_user
POSTGRES_READ_REPLICA_PASSWORD=secure_password_here

# Connection pooling
DATABASE_POOL_SIZE=20
DATABASE_IDLE_TIMEOUT=30000

# PostgreSQL connection pool configuration
# Increase for production with read replicas
POSTGRES_MAX_POOL_SIZE=50
POSTGRES_MIN_POOL_SIZE=5

# ===========================
# 🍃 MONGODB CONFIGURATION
# ===========================

# MongoDB Primary Connection
MONGODB_URI=mongodb://localhost:27017/appforge

# MongoDB Read Replicas (OPTIONAL)
# Separate read replica URI for query distribution
# Format: mongodb://host:port or mongodb+srv://cluster.mongodb.net
MONGODB_READ_REPLICA_URI=mongodb://localhost:27018/appforge

# MongoDB Connection Pool
# Increase from default 10 to 50 for production workloads
MONGODB_MAX_POOL_SIZE=50

# ===========================
# 💾 REDIS CACHE (OPTIONAL)
# ===========================
# Recommended for production for webhook queuing and caching

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379

# ===========================
# 🚀 APPLICATION CONFIGURATION
# ===========================

# Environment (development, production, staging)
NODE_ENV=development
VITE_ENV=development

# Server port
PORT=3000
HOST=localhost

# API URLs
VITE_API_BASE_URL=http://localhost:5173
VITE_API_URL=http://localhost:5000/api
APP_URL=http://localhost:5173

# CORS configuration
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# ===========================
# 🔐 SECURITY CONFIGURATION
# ===========================

# Session secret (use strong random value in production)
# Generate: openssl rand -base64 32
SESSION_SECRET=your_32_character_session_secret_here
SESSION_TIMEOUT=86400

# JWT Configuration
JWT_SECRET=your_jwt_secret_here_minimum_32_chars
JWT_EXPIRY=7d
JWT_REFRESH_SECRET=your_refresh_secret_here

# API Key Encryption Secret (32 characters)
API_KEY_ENCRYPTION_SECRET=your_32_character_encryption_key_here

# CSRF Protection
CSRF_TOKEN_ENABLED=true

# ===========================
# 📧 EMAIL CONFIGURATION
# ===========================

# Email Service Provider
EMAIL_SERVICE=gmail  # gmail, sendgrid, smtp, or mailgun

# Gmail Configuration
EMAIL_USER=your-email@example.com
EMAIL_PASSWORD=your_app_password_here
EMAIL_FROM=noreply@appforge.dev

# SendGrid Configuration
SENDGRID_API_KEY=sg_xxxxxxxxxxxx
SENDGRID_FROM_EMAIL=noreply@appforge.dev

# ===========================
# 💬 SLACK INTEGRATION
# ===========================

# Incoming Webhook URL for Slack notifications
SLACK_WEBHOOK_URL=__YOUR_SLACK_WEBHOOK_URL__

# Generic SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASSWORD=app_password_here
SMTP_FROM=noreply@appforge.dev
SMTP_TLS=true

# ===========================
# 📊 MONITORING & ANALYTICS
# ===========================

# Sentry (Error Tracking)
SENTRY_DSN=https://key@sentry.io/project-id
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1

# Datadog (Performance Monitoring)
DATADOG_API_KEY=xxxxxxxxxxxx
DATADOG_APP_KEY=xxxxxxxxxxxx
DATADOG_SITE=datadoghq.com

# PostHog (Product Analytics)
POSTHOG_API_KEY=phc_xxxxxxxxxxxx
POSTHOG_HOST=https://api.posthog.com

# Google Analytics
GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX

# ===========================
# 🔔 SLACK INTEGRATION
# ===========================

# Slack Bot Token (for sending messages)
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token

# Slack Webhook URL (for alerts)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Slack Channels
SLACK_ERROR_CHANNEL=#payment-errors
SLACK_ALERTS_CHANNEL=#payment-alerts
SLACK_NOTIFICATIONS_CHANNEL=#notifications

# ===========================
# 🔑 AUTHENTICATION (OAUTH)
# ===========================

# Google OAuth
GOOGLE_CLIENT_ID=xxxxxxxxxxxx
GOOGLE_CLIENT_SECRET=xxxxxxxxxxxx
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# GitHub OAuth
GITHUB_CLIENT_ID=xxxxxxxxxxxx
GITHUB_CLIENT_SECRET=xxxxxxxxxxxx
GITHUB_CALLBACK_URL=http://localhost:3000/auth/github/callback

# ===========================
# 🧪 TESTING CONFIGURATION
# ===========================

# Test Database
TEST_DATABASE_URL=postgresql://test_user:test_pass@localhost:5432/appforge_test

# Test Xendit Keys (Sandbox)
TEST_XENDIT_SECRET_KEY=xnd_development_secret_test_key
TEST_XENDIT_PUBLIC_KEY=xnd_development_public_test_key

# Test User Tokens
TEST_USER_TOKEN=test_token_for_integration_tests
ADMIN_TOKEN=admin_test_token_for_admin_tests

# ===========================
# 📝 LOGGING CONFIGURATION
# ===========================

# Log Level (debug, info, warn, error)
LOG_LEVEL=info

# Log Format (json or text)
LOG_FORMAT=json

# File Logging
LOG_FILE_PATH=./logs
LOG_FILE_MAX_SIZE=10m
LOG_FILE_MAX_FILES=10

# ===========================
# 🌍 FEATURE FLAGS
# ===========================

# Payment Features
FEATURE_RECURRING_SUBSCRIPTIONS=true
FEATURE_AUTO_REFUND=false
FEATURE_PAYMENT_RETRY=true
FEATURE_WEBHOOK_QUEUE=true

# Admin Features
FEATURE_ADMIN_DASHBOARD=true
FEATURE_PAYMENT_ANALYTICS=true

# ===========================
# ☁️ CLOUD STORAGE (OPTIONAL)
# ===========================

# AWS S3
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=xxxxxxxxxxxx
AWS_SECRET_ACCESS_KEY=xxxxxxxxxxxx
AWS_S3_BUCKET=appforge-bucket

# Google Cloud
GOOGLE_CLOUD_PROJECT_ID=xxxxxxxxxxxx
GOOGLE_CLOUD_CREDENTIALS={...json...}

# ===========================
# 🔄 WEBHOOK CONFIGURATION
# ===========================

# Xendit Webhooks
XENDIT_WEBHOOK_URL=https://yourdomain.com/api/webhook/xendit

# GitHub Webhooks (if using)
GITHUB_WEBHOOK_SECRET=github_webhook_secret_here

# ===========================
# 🏥 HEALTH CHECKS
# ===========================

# Health check interval (ms)
HEALTH_CHECK_INTERVAL=300000

# Health check timeout (ms)
HEALTH_CHECK_TIMEOUT=10000

# Services to check
CHECK_DATABASE=true
CHECK_REDIS=true
CHECK_XENDIT=true

# ===========================
# ⚡ PERFORMANCE CONFIGURATION
# ===========================

# Request timeout (ms)
REQUEST_TIMEOUT=30000

# Rate Limiting
RATE_LIMIT_WINDOW=900000
RATE_LIMIT_MAX_REQUESTS=100

# Caching
CACHE_TTL=3600
INVOICE_CACHE_TTL=1800

# ===========================
# 🚨 ALERT THRESHOLDS
# ===========================

# Payment success rate (%)
ALERT_PAYMENT_SUCCESS_RATE_THRESHOLD=95

# Payment processing time (ms)
ALERT_PAYMENT_TIME_THRESHOLD_MS=5000

# Monthly churn rate (%)
ALERT_CHURN_RATE_THRESHOLD=5

# API error rate (%)
ALERT_ERROR_RATE_THRESHOLD=1

# ===========================
# 🏗️ BASE44 SDK CONFIGURATION
# ===========================

# Use legacy Base44 SDK imports
BASE44_LEGACY_SDK_IMPORTS=false

# Base44 API settings
BASE44_API_TIMEOUT=30000

# ===========================
# 🎨 APPLICATION SETTINGS
# ===========================

# App Name
VITE_APP_NAME=AppForge

# App Version
APP_VERSION=1.0.0

# Feature in development
VITE_FEATURE_BETA=false
