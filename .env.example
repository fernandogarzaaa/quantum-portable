# Quantum Portable - Environment Configuration
# Copy this file to .env.local and fill in your values

# ========================================================================
# CLOUD LLM PROVIDERS
# ========================================================================

# OpenAI (GPT-4o, GPT-4o-mini)
# Get key: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Anthropic (Claude 4 Sonnet, Claude 4 Opus)
# Get key: https://console.anthropic.com/api-keys
ANTHROPIC_API_KEY=

# Google Gemini (Gemini 2.0 Flash, Gemini 1.5 Pro)
# Get key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# xAI Grok (Grok 2, Grok-beta)
# Get key: https://console.x.ai/
XAI_API_KEY=

# OpenAI Codex (Codex-1)
# Get key: https://platform.openai.com/codex
CODEX_API_KEY=

# ========================================================================
# LOCAL LLM PROVIDERS
# ========================================================================

# Ollama (Local Inference)
# Install: https://ollama.com/
# Run: ollama serve
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2

# LlamaCpp (GPU-Accelerated Local Inference)
# Install: https://github.com/ggerganov/llama.cpp
# Run: ./main --server --host 0.0.0.0 --port 8080
LLAMACPP_HOST=http://localhost:8080
LLAMACPP_MODEL=llama-2-7b

# ========================================================================
# DECENTRALIZED COMPUTE
# ========================================================================

# Akash Network (GPU Deployment)
# Get mnemonic: https://wallet.akash.net/
AKASH_MNEMONIC=
AKASH_CHAIN_ID=akashnet-2
AKASH_RPC_URL=https://rpc.akashnet.net:443

# Render.com (GPU Deployment)
# Get key: https://dashboard.render.com/
RENDER_API_KEY=

# ========================================================================
# PROVIDER PREFERENCES
# ========================================================================

# Primary provider (used when no specific requirements)
PRIMARY_PROVIDER=openai

# Fallback provider (used when primary fails)
FALLBACK_PROVIDER=ollama

# Cost threshold for local model usage (in USD)
LOCAL_MODEL_THRESHOLD=100
