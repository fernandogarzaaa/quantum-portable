    "rollup-plugin-visualizer": "^6.0.5",
    "tailwindcss": "^3.4.17",
    "terser": "^5.36.0",
    "tsx": "^4.21.0",
    "typescript": "^5.8.2",
    "vercel": "^50.14.0",
