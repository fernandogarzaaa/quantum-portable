{
  "name": "base44-app",
  "private": true,
  "version": "0.0.0",
  "license": "Apache-2.0",
  "type": "module",
  "main": "scripts/electron-main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint . --quiet",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc -p ./jsconfig.json",
    "preview": "vite preview",
    "swarm:daemon": "pm2 start ecosystem.config.cjs",
    "swarm:stop": "pm2 stop appforge-swarm",
    "swarm:logs": "pm2 logs appforge-swarm",
    "swarm:benchmark": "tsx scripts/benchmark_swarm_intelligence.ts",
    "swarm:oracle:report": "tsx scripts/report_benchmark_to_oracle.ts",
    "swarm:cli": "tsx scripts/swarm_cli.js",
    "swarm:learning": "tsx scripts/run_learning_swarm.ts",
    "swarm:research": "tsx scripts/run_research_swarm.ts",
    "swarm:voice": "tsx scripts/run_voice_swarm.ts",
    "swarm:qa": "tsx scripts/run_qa_swarm.ts",
    "swarm:customer-success": "tsx scripts/run_customer_success_swarm.ts",
    "swarm:devops": "tsx scripts/run_devops_swarm.ts",
    "swarm:knowledge-graph": "tsx scripts/run_knowledge_graph_swarm.ts",
    "swarm:compliance": "tsx scripts/run_compliance_swarm.ts",
    "swarm:experimentation": "tsx scripts/run_experimentation_swarm.ts",
    "swarm:economy": "tsx scripts/run_ai_economy_swarm.ts",
    "swarm:consult:economy": "tsx swarm/consult_ai_economy.ts",
    "swarm:benchmark:trading:real": "tsx scripts/run_real_trading_benchmark.ts",
    "swarm:autotrade": "tsx scripts/run_autonomous_trading.ts --watch",
    "swarm:autotrade:status": "tsx scripts/run_autonomous_trading.ts --once",
    "swarm:autotrade:reset": "tsx scripts/run_autonomous_trading.ts --reset --once",
    "swarm:reality:check": "tsx scripts/reality_guard_check.ts",
    "swarm:audit:collectives": "tsx scripts/audit_swarm_collectives.ts",
    "swarm:status": "pm2 status",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --config vitest.config.coverage.js --run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:all": "npm run test && npm run test:e2e",
    "build:quantum": "cd quantum-core && wasm-pack build --target web --out-dir ../src/quantum-core/pkg",
    "build:quantum:release": "cd quantum-core && wasm-pack build --release --target web --out-dir ../src/quantum-core/pkg",
    "build:analyzer": "cd static-analyzer-core && wasm-pack build --target web --out-dir ../src/static-analyzer-core/pkg",
    "build:analyzer:release": "cd static-analyzer-core && wasm-pack build --release --target web --out-dir ../src/static-analyzer-core/pkg",
    "start:server": "node server.js",
    "deploy": "node scripts/deploy_swarm.js",
    "app:desktop": "electron ."
  },
  "dependencies": {
    "@apollo/client": "latest",
    "@apollo/server": "^4.10.5",
    "@base44/sdk": "^0.8.18",
    "@base44/vite-plugin": "^0.2.14",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-yaml": "^6.1.0",
    "@codemirror/theme-one-dark": "^6.1.2",
    "@google/genai": "^1.41.0",
    "@hello-pangea/dnd": "^17.0.0",
    "@hookform/resolvers": "^4.1.2",
    "@radix-ui/react-accordion": "^1.2.3",
    "@radix-ui/react-alert-dialog": "^1.1.6",
    "@radix-ui/react-aspect-ratio": "^1.1.2",
    "@radix-ui/react-avatar": "^1.1.3",
    "@radix-ui/react-checkbox": "^1.1.4",
    "@radix-ui/react-collapsible": "^1.1.3",
    "@radix-ui/react-context-menu": "^2.2.6",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-hover-card": "^1.1.6",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-menubar": "^1.1.6",
    "@radix-ui/react-navigation-menu": "^1.2.5",
    "@radix-ui/react-popover": "^1.1.6",
    "@radix-ui/react-progress": "^1.1.2",
    "@radix-ui/react-radio-group": "^1.2.3",
    "@radix-ui/react-scroll-area": "^1.2.3",
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-separator": "^1.1.2",
    "@radix-ui/react-slider": "^1.2.3",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-switch": "^1.1.3",
    "@radix-ui/react-tabs": "^1.1.3",
    "@radix-ui/react-toast": "^1.2.2",
    "@radix-ui/react-toggle": "^1.1.2",
    "@radix-ui/react-toggle-group": "^1.1.2",
    "@radix-ui/react-tooltip": "^1.1.8",
    "@sentry/react": "^10.38.0",
    "@solana/spl-token": "^0.4.14",
    "@solana/web3.js": "^1.98.4",
    "@tanstack/query-sync-storage-persister": "^5.90.22",
    "@tanstack/react-query": "^5.84.1",
    "@tanstack/react-query-persist-client": "^5.90.22",
    "@types/express": "^5.0.6",
    "@types/socket.io": "^3.0.1",
    "@uiw/react-codemirror": "^4.23.6",
    "axios": "^1.7.9",
    "bip39": "^3.1.0",
    "bs58": "^6.0.0",
    "buffer": "^6.0.3",
    "bull": "^4.11.1",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.0.0",
    "cors": "^2.8.6",
    "date-fns": "^3.6.0",
    "dotenv": "^17.2.4",
    "ed25519-hd-key": "^1.3.0",
    "embla-carousel-react": "^8.5.2",
    "express": "^5.2.1",
    "express-rate-limit": "^7.5.1",
    "framer-motion": "^11.0.0",
    "graphql": "^16.9.0",
    "graphql-tag": "^2.12.6",
    "hdkey": "^2.1.0",
    "helmet": "^7.1.0",
    "html2canvas": "^1.4.1",
    "input-otp": "^1.4.2",
    "ioredis": "^5.9.2",
    "jspdf": "^2.5.2",
    "lodash": "^4.17.21",
    "lucide-react": "^0.475.0",
    "next-themes": "^0.4.4",
    "node-fetch": "^3.3.2",
    "nodemailer": "^8.0.1",
    "qrcode.react": "^4.2.0",
    "quill": "^2.0.3",
    "react": "^18.3.0",
    "react-day-picker": "^8.10.1",
    "react-dom": "^18.3.0",
    "react-hook-form": "^7.54.2",
    "react-hot-toast": "^2.6.0",
    "react-leaflet": "^4.2.1",
    "react-markdown": "^9.0.1",
    "react-quill": "^2.0.0",
    "react-resizable-panels": "^2.1.7",
    "react-router-dom": "^6.26.0",
    "react-syntax-highlighter": "^15.5.0",
    "recharts": "^2.15.0",
    "redis": "^4.7.1",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "sonner": "^2.0.1",
    "tailwind-merge": "^3.0.2",
    "tailwindcss-animate": "^1.0.7",
    "three": "^0.171.0",
    "vaul": "^1.1.2",
    "web-vitals": "^5.1.0",
    "yaml": "^2.5.1",
    "zod": "^3.24.2",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@babel/core": "^7.23.5",
    "@babel/preset-env": "^7.23.5",
    "@babel/preset-react": "^7.23.3",
    "@babel/preset-typescript": "^7.23.3",
    "@eslint/js": "^9.19.0",
    "@playwright/test": "^1.58.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.13.5",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^4.0.18",
    "@vitest/ui": "^4.0.18",
    "autoprefixer": "^10.4.20",
    "babel-jest": "^29.7.0",
    "babel-plugin-transform-react-remove-prop-types": "^0.4.24",
    "baseline-browser-mapping": "^2.8.32",
    "electron": "^40.4.0",
    "electron-builder": "^26.7.0",
    "eslint": "^9.19.0",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.18",
    "eslint-plugin-unused-imports": "^4.3.0",
    "globals": "^15.14.0",
    "happy-dom": "^20.4.0",
    "identity-obj-proxy": "^3.0.0",
